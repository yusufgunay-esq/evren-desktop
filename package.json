{
  "name": "evren-masaustu",
  "version": "0.5.0",
  "private": true,
  "description": "EVREN Desktop: EVREN API üzerinde kodlama ajanı için operasyon konsolu (Windows · macOS)",
  "main": "main.js",
  "scripts": {
    "basla": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "dist": "electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@homebridge/node-pty-prebuilt-multiarch": "^0.15.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "qrcode": "^1.5.4",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "author": "Yusuf Günay",
  "license": "GPL-3.0-or-later",
  "homepage": "https://github.com/yusufgunay-esq/evren-desktop",
  "repository": {
    "type": "git",
    "url": "https://github.com/yusufgunay-esq/evren-desktop.git"
  },
  "bugs": {
    "url": "https://github.com/yusufgunay-esq/evren-desktop/issues"
  },
  "keywords": [
    "evren",
    "electron",
    "terminal",
    "conpty",
    "xterm",
    "claude-code",
    "turkiye"
  ],
  "build": {
    "appId": "com.gunaystudio.evren",
    "productName": "EVREN",
    "copyright": "Copyright © 2026 Yusuf Günay",
    "directories": {
      "output": "cikti-masaustu"
    },
    "files": [
      "**/*",
      "!test/**",
      "!docs/**",
      "!_claude/**",
      "!_rea_*/**",
      "!_ekran/**",
      "!_demo/**",
      "!cikti-masaustu/**",
      "!store/**"
    ],
    "asarUnpack": [
      "node_modules/@homebridge/node-pty-prebuilt-multiarch/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "ikon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "EVREN"
    },
    "npmRebuild": false,
    "electronVersion": "45.3.1"
  }
}
